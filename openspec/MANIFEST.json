  "database_design": {
    "tables": 2,
    "total_fields": 24,
    "subjects_table": {
      "name": "subjects",
      "fields": 17,
      "purpose": "Store academic subjects/disciplines",
      "owner_field": "user_id",
      "key_fields": [
        "id (UUID, primary key)",
        "user_id (UUID, foreign key to users)",
        "name (string, required)",
        "code (string, optional, unique per user)",
        "professor_name, professor_email",
        "semester, credits, workload_hours",
        "start_date, end_date",
        "status (enum: active/completed/archived/cancelled)",
        "color (hex), notes",
        "created_at, updated_at"
      ]
    },
    "permissions_table": {
      "name": "subject_permissions",
      "fields": 7,
      "purpose": "Fine-grained access control",
      "key_fields": [
        "id (UUID, primary key)",
        "subject_id (UUID, foreign key)",
        "user_id (UUID, foreign key)",
        "permission_type (enum: owner/editor/viewer/commenter)",
        "granted_by (UUID, who granted)",
        "created_at, expires_at"
      ]
    },
    "constraints": "15+",
    "indexes": "10+",
    "functions": 5,
    "triggers": 1,
    "views": 3
  },

  "api_design": {
    "total_endpoints": 9,
    "authentication": "JWT (JSON Web Tokens)",
    "authorization": "Fine-grained permissions (4 levels)",
    "endpoints": [
      {
        "method": "POST",
        "path": "/api/subjects",
        "description": "Create new subject"
      },
      {
        "method": "GET",
        "path": "/api/subjects",
        "description": "List user's subjects (with filters)"
      },
      {
        "method": "GET",
        "path": "/api/subjects/:id",
        "description": "Get single subject"
      },
      {
        "method": "PUT",
        "path": "/api/subjects/:id",
        "description": "Update subject"
      },
      {
        "method": "DELETE",
        "path": "/api/subjects/:id",
        "description": "Delete subject (owner only)"
      },
      {
        "method": "GET",
        "path": "/api/subjects/:id/permissions",
        "description": "List permissions (owner only)"
      },
      {
        "method": "POST",
        "path": "/api/subjects/:id/permissions",
        "description": "Grant permission (owner only)"
      },
      {
        "method": "DELETE",
        "path": "/api/subjects/:id/permissions/:user_id",
        "description": "Revoke permission (owner only)"
      }
    ]
  },

  "authorization_model": {
    "permission_levels": 4,
    "levels": [
      {
        "level": "owner",
        "value": 4,
        "capabilities": ["read", "write", "delete", "manage_permissions"]
      },
      {
        "level": "editor",
        "value": 3,
        "capabilities": ["read", "write"]
      },
      {
        "level": "commenter",
        "value": 2,
        "capabilities": ["read", "comment"]
      },
      {
        "level": "viewer",
        "value": 1,
        "capabilities": ["read"]
      }
    ],
    "rules": [
      "User can access if they own the subject",
      "User can access if they have explicit permission",
      "Permission can have optional expiration date",
      "Expired permissions are automatically revoked"
    ]
  },

